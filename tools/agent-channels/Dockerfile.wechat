# Optional image. Build the normal Lite image first; no Tencent binary is in source or release ZIP.
ARG BASE_IMAGE=qicheng-agent-channels:0.1-local
FROM ${BASE_IMAGE}
USER root
RUN rm -rf /app
COPY backend /app
RUN mkdir -p /etc/firefox/policies && cp /app/firefox-policies.json /etc/firefox/policies/policies.json && chmod 755 /app/start.sh
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      ca-certificates curl libgbm1 libxss1 libasound2 libnss3 libatk1.0-0 libatk-bridge2.0-0 \
      libxkbcommon0 libgtk-3-0 libdrm2 libxcomposite1 libxdamage1 libxrandr2 libxfixes3 \
    && curl --fail --location --retry 3 --output /tmp/wechat-devtools.deb \
      https://github.com/msojocs/wechat-web-devtools-linux/releases/download/v2.02.2608070-2/io.github.msojocs.wechat-devtools-linux_2.02.2608070-2_amd64.deb \
    && printf '%s  %s\n' c5246f3f7548905a8e768ed464d9f6400e3a59d0cd539f1fe6a85dde29860457 /tmp/wechat-devtools.deb | sha256sum --check --status \
    && apt-get install -y --no-install-recommends /tmp/wechat-devtools.deb \
    && rm -f /tmp/wechat-devtools.deb \
    && rm -rf /var/lib/apt/lists/*
COPY wechat-devtools-cli /usr/local/bin/wechat-devtools-cli
COPY wechat-cli-result.py /usr/local/libexec/wechat-cli-result.py
RUN chmod 755 /usr/local/bin/wechat-devtools-cli
USER channel
